{
  "name": "pixiora",
  "private": true,
  "version": "1.0.0",
  "description": "PIXIORA — privacy-first, browser-local image optimization studio",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "fixtures": "python3 scripts/make_fixtures.py"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "clsx": "2.1.1",
    "framer-motion": "14.10.1",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "libheif-js": "1.23.5",
    "lucide-react": "1.70.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.5",
    "svgo": "4.1.0",
    "tailwind-merge": "3.7.0",
    "utif": "3.1.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "^3.2.7"
  }
}
